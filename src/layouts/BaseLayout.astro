---
interface Props {
  title: string;
  description?: string;
  ogType?: string;
  image?: string;
}

const {
  title,
  description = 'Software engineer based in Brisbane, Australia. Frontend specialist with experience across startups, agencies, and enterprise teams.',
  ogType = 'website',
  image,
} = Astro.props;

const currentPath = Astro.url.pathname;
const canonicalURL = Astro.url.href;
---

<!DOCTYPE html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0d0d0d" />

    <!--
      Fonts first: this page is nothing but type. `wght@400..900` requests one
      variable Archivo (~45KB) rather than five statics (~90KB); the design only
      ever uses 400/800/900 and DM Mono 400. Both preconnects matter — the woff2
      fetch on gstatic can't start until the googleapis CSS lands.
      `display=swap` is safe here because the 1s frame draw hides the swap.
    -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400..900&family=Archivo+Black&family=DM+Mono&display=swap"
    />

    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-ZX84MMMEQ9"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-ZX84MMMEQ9');
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="en_AU" />
    {image && <meta property="og:image" content={image} />}

    <!-- Twitter -->
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {image && <meta name="twitter:image" content={image} />}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <slot name="head" />
  </head>
  <body class="min-h-screen antialiased">
    <nav class="fixed-nav">
      {currentPath !== '/' && <a href="/">Home</a>}
      {!currentPath.startsWith('/articles') && <a href="/articles">Blog</a>}
      {currentPath !== '/contact' && <a href="/contact">Contact</a>}
    </nav>

    <div class="frame-masks" aria-hidden="true">
      <div class="frame-mask-top"></div>
      <div class="frame-mask-bottom"></div>
      <div class="frame-mask-left"></div>
      <div class="frame-mask-right"></div>
    </div>

    <div class="frame-border" aria-hidden="true">
      <div class="frame-top"></div>
      <div class="frame-right"></div>
      <div class="frame-bottom"></div>
      <div class="frame-left"></div>
    </div>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="site-footer-inner">
        <p class="site-footer-line">
          Wade Nairn · Software Engineer · Brisbane, Australia
        </p>
        <p class="site-footer-sub">
          Software Engineering &amp; Creative Development
        </p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  /*
    Design tokens for the "Kinetic Stack" design. Must be `is:global` — Astro's
    scoping hash never lands on `:root`, so a `:root` block inside a plain
    scoped <style> silently does nothing.
  */
  :root {
    /*
      Ground is #0d0d0d, NOT the design spec's #0a0a0a: the four frame masks
      below hardcode #0d0d0d and must keep matching the page exactly. The
      difference between the two is imperceptible; a mismatch would not be.
    */
    --bg: #0d0d0d;
    --bg-rgb: 13, 13, 13; /* for rgba() interpolation in the hero scrim */

    --ink-fg: #f2f0ed;    /* primary text, nav, hero name */
    --ink-muted: #cfcdca; /* hero caption, card host line, footer line 1 */
    --ink-body: #c9c7c4;  /* About prose */
    --ink-blurb: #a9a7a4; /* project blurb */
    --ink-meta: #8f8d8a;  /* row meta, card meta, link hover */
    --ink-label: #8a8a8a; /* section labels */
    --ink-faint: #5f5d5b; /* projects aside, footer line 2 */

    --rule: rgba(255, 255, 255, 0.14);
    --wash-row: rgba(255, 255, 255, 0.04);
    --wash-card: rgba(255, 255, 255, 0.05);

    --stroke-1: rgba(255, 255, 255, 0.16);
    --stroke-2: rgba(255, 255, 255, 0.13);
    --stroke-3: rgba(255, 255, 255, 0.1);
    --stroke-4: rgba(255, 255, 255, 0.08);

    /*
      Measured against the frame, not the masks: the border bar sits at 24px
      and is 2px thick, so its inner edge is at 26px and content must clear
      *that* to look inset rather than pinned to the line.

      8vw reaches the 72px ceiling at exactly 900px, so desktop keeps its gutter
      and everything below scales with the viewport. The 44px floor takes over
      at ~550px, leaving 18px of clear air beside the border on a phone.
    */
    --pad-x: clamp(44px, 8vw, 72px);
    --pad-y: clamp(72px, 12vh, 160px);
    --max-section: 1240px;
    --max-hero: 1100px;
    --measure: 620px;

    --font-display: 'Archivo Black', 'Archivo', Helvetica, sans-serif;
    --font-mono: 'DM Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
    --ease-rise: cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  body {
    background: var(--bg);
    color: var(--ink-fg);
  }

  ::selection {
    background: var(--ink-fg);
    color: var(--bg);
  }
</style>

<style>
  .fixed-nav {
    position: fixed;
    top: 48px;
    right: 48px;
    z-index: 101;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 8px;
    opacity: 0;
    animation: fade-in 0.6s ease-out 1s forwards;
    /*
      Keeps the nav legible when near-white content scrolls under it. The nav
      sits at 48/48, clearing the white frame bars (top y 24-26, right x W-26
      to W-24) by 22px on both axes, so it never inverts against the frame.
      Do not add `isolation: isolate` to a wrapper — that gives the nav an empty
      backdrop and makes the blend a no-op.
    */
    mix-blend-mode: difference;
  }

  .fixed-nav a {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-fg);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .fixed-nav a:hover {
    color: var(--ink-meta);
  }

  @keyframes fade-in {
    to { opacity: 1; }
  }

  /* Footer — the closing element of the page */
  .site-footer {
    border-top: 1px solid var(--rule);
    background: var(--bg);
  }

  .site-footer-inner {
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-width: var(--max-section);
    /*
      72px bottom floor, not 48px: at a 640px-tall viewport the last line would
      otherwise sit inside the 56px .frame-mask-bottom gradient and get dimmed.
    */
    padding: clamp(40px, 6vh, 72px) var(--pad-x) clamp(72px, 8vh, 96px);
  }

  .site-footer-line,
  .site-footer-sub {
    margin: 0;
    font-family: var(--font-mono);
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .site-footer-line {
    font-size: 12px;
    color: var(--ink-muted);
  }

  .site-footer-sub {
    font-size: 11px;
    color: var(--ink-faint);
  }

  /* Masks: cover the outer gap AND fade content just inside the border */
  .frame-masks {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 99;
  }

  .frame-mask-top,
  .frame-mask-bottom,
  .frame-mask-left,
  .frame-mask-right {
    position: absolute;
  }

  /* Top/bottom: 24px solid (gap cover) + 32px gradient (inner fade) */
  .frame-mask-top {
    top: 0; left: 0; right: 0;
    height: 56px;
    background: linear-gradient(to bottom, #0d0d0d 43%, transparent);
  }

  .frame-mask-bottom {
    bottom: 0; left: 0; right: 0;
    height: 56px;
    background: linear-gradient(to top, #0d0d0d 43%, transparent);
  }

  /* Left/right: solid gap cover only (content already has px-16 clearance) */
  .frame-mask-left {
    top: 0; bottom: 0; left: 0;
    width: 24px;
    background: #0d0d0d;
  }

  .frame-mask-right {
    top: 0; bottom: 0; right: 0;
    width: 24px;
    background: #0d0d0d;
  }

  .frame-border {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 100;
  }

  .frame-top,
  .frame-right,
  .frame-bottom,
  .frame-left {
    position: absolute;
    background: white;
  }

  /* Top: left corner → right */
  .frame-top {
    top: 24px;
    left: 24px;
    right: 24px;
    height: 2px;
    transform: scaleX(0);
    transform-origin: left center;
    animation: frame-draw-h 1s ease-out forwards;
  }

  /* Right: top corner → down */
  .frame-right {
    top: 24px;
    right: 24px;
    bottom: 24px;
    width: 2px;
    transform: scaleY(0);
    transform-origin: center top;
    animation: frame-draw-v 1s ease-out forwards;
  }

  /* Bottom: right corner → left */
  .frame-bottom {
    bottom: 24px;
    left: 24px;
    right: 24px;
    height: 2px;
    transform: scaleX(0);
    transform-origin: right center;
    animation: frame-draw-h 1s ease-out forwards;
  }

  /* Left: bottom corner → up */
  .frame-left {
    top: 24px;
    left: 24px;
    bottom: 24px;
    width: 2px;
    transform: scaleY(0);
    transform-origin: center bottom;
    animation: frame-draw-v 1s ease-out forwards;
  }

  @media (max-width: 768px) {
    .fixed-nav {
      flex-direction: row;
      gap: 20px;
    }

    /* Extend top mask to cover the height of the nav row */
    .frame-mask-top {
      height: 125px;
      background: linear-gradient(to bottom, #0d0d0d 45%, transparent);
    }
  }

  @keyframes frame-draw-h { to { transform: scaleX(1); } }
  @keyframes frame-draw-v { to { transform: scaleY(1); } }

  @media (prefers-reduced-motion: reduce) {
    .frame-top,
    .frame-right,
    .frame-bottom,
    .frame-left {
      animation: none;
      transform: none;
    }
    .fixed-nav {
      animation: none;
      opacity: 1;
    }
  }
</style>
