---
import BaseLayout from '../layouts/BaseLayout.astro';

const work = [
  { name: "Lite n' Easy", meta: 'Current · Frontend Lead' },
  { name: 'Shine Lawyers', meta: 'Platform · Vue' },
  { name: 'WooliesX', meta: 'Enterprise · React' },
  { name: 'SportsDash', meta: 'Product · Full-stack' },
  { name: 'Adventus.io', meta: 'Design System' },
  { name: 'Bionic', meta: 'UK · Frontend' },
  { name: 'Infinite Software', meta: 'Agency' },
  { name: 'Nissan Australia', meta: 'Enterprise' },
];

// The trailing ` · ` on each phrase is load-bearing — it is what creates the
// gap between repeats. Each row renders the phrase twice so the -50% translate
// lands exactly on the duplicate.
const marquee = [
  { cls: 'mq-1', text: 'SHIPPED TO PRODUCTION · MEASURABLE IMPACT · ' },
  { cls: 'mq-2', text: 'FASTER RELEASES · LOWER FAILURE RATE · ' },
  { cls: 'mq-3', text: 'SCALED TO MILLIONS · COST PER USER DOWN · ' },
  { cls: 'mq-4', text: 'TEAMS THAT COMPOUND · SYSTEMS THAT LAST · ' },
];

// The meta and blurb lines are parked until there is real copy for them. To
// bring them back: fill in the fields below and uncomment the two matching
// spans in the card markup (search for `card-meta` / `card-blurb`).
const projects = [
  {
    name: 'Whisky Map',
    // meta: '2024 · Side project',
    // blurb: 'One line on what it does and why it exists.',
    host: 'whiskymap.com.au',
    url: 'https://whiskymap.com.au',
  },
  {
    name: 'Endless Lofi',
    // meta: '2024 · Side project',
    // blurb: 'One line on what it does and why it exists.',
    host: 'endlesslofi.space',
    url: 'https://endlesslofi.space',
  },
  {
    name: 'NRL Tipping',
    // meta: '2025 · Side project',
    // blurb: 'One line on what it does and why it exists.',
    host: 'nrltipping.club',
    url: 'https://nrltipping.club',
  },
  {
    name: 'Neo Dreams',
    // meta: '2025 · Side project',
    // blurb: 'One line on what it does and why it exists.',
    host: 'neodreams.studio',
    url: 'https://neodreams.studio',
  },
];
---

<BaseLayout title="Wade Nairn — Frontend Engineer & Creative Developer">
  <!-- Hero -->
  <section class="hero">
    <div class="hero-bg" aria-hidden="true">
      <div class="mq-stack">
        {marquee.map((row) => (
          <div class={`mq-row ${row.cls}`}>
            <span>{row.text}</span>
            <span>{row.text}</span>
          </div>
        ))}
      </div>
      <div class="scrim"></div>
    </div>

    <div class="hero-lockup">
      <h1 class="hero-name">Wade<br />Nairn</h1>
      <div class="hero-caption">
        <span class="hero-rule"></span>
        <span>Software Engineer — Brisbane, Australia</span>
      </div>
    </div>
  </section>

  <!-- About -->
  <section class="section section-about">
    <span class="label">About</span>
    <div class="about-copy">
      <p>I'm a software engineer based in Brisbane with close to a decade of experience across startups, agencies, and enterprise teams in Australia, the UK, and remotely. I've led teams, architected platforms, and shipped products — from design systems and component libraries to full-stack applications and API integrations.</p>
      <p>My focus is on the frontend: React, Vue, TypeScript, and the craft of building interfaces that are fast, accessible, and well considered. I'm equally comfortable working across the stack, managing DevOps pipelines, or leading a small team through a product build. I care about the details — smooth interactions, accessible interfaces, and code that's as considered as the product it ships.</p>
    </div>
  </section>

  <!-- Work -->
  <section class="section section-work">
    <span class="label">Work</span>
    <ul class="work-list">
      {work.map((job) => (
        <li class="work-row">
          <span class="work-name">{job.name}</span>
          <span class="work-meta">{job.meta}</span>
        </li>
      ))}
    </ul>
  </section>

  <!-- Projects -->
  <section class="section section-projects">
    <div class="projects-head">
      <span class="label">Projects</span>
      <span class="projects-aside">Things I build on my own time</span>
    </div>
    <div class="card-grid">
      {projects.map((project) => (
        <a class="card" href={project.url} target="_blank" rel="noopener noreferrer">
          <span class="card-top">
            {/* <span class="card-meta">{project.meta}</span> */}
            <span class="card-name">{project.name}</span>
            {/* <span class="card-blurb">{project.blurb}</span> */}
          </span>
          <span class="card-host">{project.host} <span aria-hidden="true">↗</span></span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  /*
    No `z-index` anywhere in this file. The three hero layers paint correctly on
    DOM order alone, and any positive value here risks escalating page content
    past the shell's fixed mask (99) / frame (100) / nav (101) layers.
  */

  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    /* Required: the max-content marquee rows must not create page scroll. */
    overflow: hidden;
    background: var(--bg);
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    opacity: 0;
    animation: hero-in 0.6s ease-out 1s forwards;
  }

  .mq-stack {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 8px;
  }

  /*
    `width: max-content`, never `200%`: translateX(-50%) only lands on the
    duplicate span if the box is exactly two copies wide. A percentage resolves
    against the containing block instead and reintroduces a visible jump.
  */
  .mq-row {
    display: flex;
    width: max-content;
    white-space: nowrap;
    font-family: var(--font-display);
    font-size: clamp(48px, 7.5vw, 104px);
    line-height: 0.95;
    color: transparent;
    will-change: transform;
  }

  .mq-row span {
    flex: none;
    padding-right: 44px;
  }

  .mq-1 {
    -webkit-text-stroke: 1px var(--stroke-1);
    animation: mqL 88s linear infinite;
  }

  .mq-2 {
    -webkit-text-stroke: 1px var(--stroke-2);
    animation: mqR 110s linear infinite;
  }

  .mq-3 {
    -webkit-text-stroke: 1px var(--stroke-3);
    animation: mqL 74s linear infinite;
  }

  .mq-4 {
    -webkit-text-stroke: 1px var(--stroke-4);
    animation: mqR 98s linear infinite;
  }

  /* No standard fallback for -webkit-text-stroke: show filled ghost type. */
  @supports not (-webkit-text-stroke: 1px #fff) {
    .mq-1 { color: var(--stroke-1); }
    .mq-2 { color: var(--stroke-2); }
    .mq-3 { color: var(--stroke-3); }
    .mq-4 { color: var(--stroke-4); }
  }

  /*
    Tuned to rgba(var(--bg-rgb)) rather than the prototype's literal
    rgba(10,10,10,…) — on this page's #0d0d0d ground that would read as a
    distinctly darker blotch behind the name instead of disappearing into it.
  */
  .scrim {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      65% 60% at 26% 50%,
      rgba(var(--bg-rgb), 0.95) 0%,
      rgba(var(--bg-rgb), 0.72) 55%,
      rgba(var(--bg-rgb), 0.2) 100%
    );
  }

  .hero-lockup {
    position: relative;
    width: 100%;
    max-width: var(--max-hero);
    padding: 0 var(--pad-x);
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .hero-name {
    margin: 0;
    font-weight: 900;
    font-size: clamp(56px, 11vw, 132px);
    line-height: 0.86;
    letter-spacing: -0.045em;
    color: var(--ink-fg);
  }

  .hero-caption {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    /* Wraps rather than shrinks on narrow screens — 1.6 makes that deliberate. */
    line-height: 1.6;
    color: var(--ink-muted);
  }

  .hero-rule {
    flex: none;
    width: 56px;
    height: 1px;
    background: var(--ink-fg);
  }

  /*
    The 1s delay is the site-wide contract: content appears exactly as the
    fixed frame finishes drawing itself. In the `animation` shorthand the first
    <time> is duration and the second is delay — kept adjacent so that is
    auditable at a glance. `both` fill supplies the hidden pre-delay state, so
    the reduced-motion rules below need only `animation: none`.
  */
  .hero-name {
    animation: rise 0.9s 1s var(--ease-rise) both;
  }

  .hero-caption {
    animation: rise 1s 1.18s var(--ease-rise) both;
  }

  /* ---------- Shared section scaffolding ---------- */
  .section {
    position: relative;
    padding: 0 var(--pad-x) var(--pad-y);
  }

  .label {
    display: block;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--ink-label);
  }

  /* ---------- About ---------- */
  .section-about {
    padding-top: var(--pad-y);
    display: flex;
    flex-wrap: wrap;
    gap: clamp(28px, 5vw, 72px);
  }

  .section-about > .label {
    flex: 0 0 200px;
  }

  /*
    Deliberately not named `prose`: @tailwindcss/typography is registered, and
    its .prose ruleset (including max-width: 65ch) would silently fight the
    620px measure below.
  */
  .about-copy {
    /* Wraps to its own line below ~1000px, which is the mobile stack. */
    flex: 1 1 480px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    max-width: var(--measure);
    font-size: clamp(16px, 1.5vw, 19px);
    line-height: 1.65;
    color: var(--ink-body);
    text-wrap: pretty;
  }

  .about-copy p {
    margin: 0;
  }

  /* ---------- Work ---------- */
  .section-work > .label {
    margin-bottom: 28px;
  }

  /* The closing hairline is this border-bottom, not a trailing empty element. */
  .work-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-bottom: 1px solid var(--rule);
  }

  /*
    Rows are non-interactive: there are no case studies to link to yet, so they
    carry no hover wash either — a highlight with no destination is misleading.
  */
  .work-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    padding: 18px 0;
    border-top: 1px solid var(--rule);
  }

  .work-name {
    font-weight: 800;
    font-size: clamp(22px, 3vw, 38px);
    letter-spacing: -0.03em;
    color: var(--ink-fg);
  }

  .work-meta {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-meta);
  }

  /* ---------- Projects ---------- */
  .projects-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 14px;
    margin-bottom: 28px;
  }

  .projects-aside {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  /*
    The 1px gap is revealed by the page ground; each card draws its own hairline
    as a box-shadow rather than a border, so an odd card count leaves an empty
    cell showing nothing rather than a stray light block.
  */
  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: 1px;
    background: var(--bg);
  }

  .card {
    background: var(--bg);
    padding: 26px 22px 22px;
    min-height: 190px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 12px;
    color: var(--ink-fg);
    text-decoration: none;
    box-shadow: 0 0 0 1px var(--rule);
    transition: background 0.2s ease;
  }

  .card:hover {
    background: var(--wash-card);
  }

  .card-top {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  /* .card-meta and .card-blurb are unused while the two spans in the card
     markup are commented out. Kept so restoring them needs no style work. */
  .card-meta {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-meta);
  }

  .card-name {
    font-weight: 800;
    font-size: clamp(22px, 2.4vw, 30px);
    letter-spacing: -0.03em;
    line-height: 1.05;
  }

  .card-blurb {
    font-size: 15px;
    line-height: 1.55;
    color: var(--ink-blurb);
    text-wrap: pretty;
  }

  .card-host {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  /* ---------- Motion ---------- */
  @keyframes mqL {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }

  @keyframes mqR {
    from { transform: translateX(-50%); }
    to   { transform: translateX(0); }
  }

  @keyframes rise {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @keyframes hero-in {
    to { opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-bg {
      animation: none;
      opacity: 1;
    }

    .hero-name,
    .hero-caption {
      animation: none;
      opacity: 1;
      transform: none;
    }

    /*
      Both mqL and mqR settle at translateX(0) with no animation. Correct as-is:
      each row holds two identical spans, so copy 1 at 0% and copy 2 at -50% are
      the same glyphs in the same place. Do not "fix" this by adding
      translateX(-50%) to the mqR rows — it is a confusing no-op.
    */
    .mq-row {
      animation: none;
      will-change: auto;
    }
  }
</style>
